{
  "buildCommand": "echo 'Static site ready'",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/Gabby-design/listen/releases/download/v0.0.7/Listen-Setup-0.0.7.exe",
      "permanent": false
    },
    {
      "source": "/download/windows",
      "destination": "https://github.com/Gabby-design/listen/releases/download/v0.0.7/Listen-Setup-0.0.7.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

