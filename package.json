{
  "name": "listen-dictation",
  "version": "0.0.6",
  "description": "Production-ready desktop voice dictation app for Windows & macOS",
  "main": "main.js",
  "scripts": {
    "build": "echo 'Static site ready'",
    "start": "electron .",
    "test": "node tests/test-formatter.js && node tests/test-audio-filtering.js && node tests/test-audiocontrol.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.gabby.listen",
    "productName": "Listen",
    "publish": [
      {
        "provider": "github",
        "owner": "Gabby-design",
        "repo": "listen"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Listen Dictation",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "config.js",
      "config.json",
      "history.js",
      "paste.js",
      "preload-overlay.js",
      "preload-settings.js",
      "assets/**/*",
      "overlay/**/*",
      "settings/**/*"
    ],
    "asarUnpack": [
      "assets/bin/**/*"
    ]
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "groq",
    "openai",
    "electron",
    "voice-typing"
  ],
  "author": "Gabby-design",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
